{
  "ConnectionStrings": {
    "Default": "Data Source=secure_upload_portal.db"
  },
  "PasswordHashing": {
    "MemorySizeKb": 65536,
    "Iterations": 3,
    "DegreeOfParallelism": 2,
    "SaltLengthBytes": 32,
    "HashLengthBytes": 32
  },
  "SessionSettings": {
    "SessionLifetimeMinutes": 60
  },
  "UploadSettings": {
    "MaxFileSizeBytes": 5242880,
    "ShareLinkLifetimeMinutes": 10,
    "ShareLinkMaxDownloads": 3,
    "StorageFolder": "App_Data/uploads",
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".txt" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}